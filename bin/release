#!/usr/bin/env bash
#
# Contiu — release em produção.
#
# Corre no servidor (como um utilizador do grupo docker), a partir de qualquer pasta:
#
#   /opt/webserver/contiu/bin/release               publica o que estiver em origin/main
#   /opt/webserver/contiu/bin/release --dry-run     mostra o que ia correr, sem mudar nada
#   /opt/webserver/contiu/bin/release --skip-backup não faz o backup da base de dados antes
#   /opt/webserver/contiu/bin/release --skip-build  não compila o tema (CSS/JS)
#   /opt/webserver/contiu/bin/release --force       repete o deploy mesmo sem commits novos
#
# Sequência: verificações → manutenção → backup da BD → git pull → composer →
# build do tema → migrações → caches → reiniciar o scheduler → sair da manutenção.
#
# Se um passo falhar depois do git pull, o site FICA em manutenção (para ninguém usar
# código novo com a base de dados antiga, ou o contrário). Corrige e corre o script outra
# vez, ou sai da manutenção à mão com o comando que ele mostra. Se falhar antes
# (verificações, backup), sai da manutenção sozinho.
#
# Onde corre cada coisa (os containers de /opt/docker; o código está em /var/www/contiu):
#   git, composer, npm   → dockerworker, como ubuntu
#   php artisan          → php-fpm, como www-data (o mesmo utilizador da app)
#   scheduler            → php-worker, programa contiu-scheduler do supervisord
#                          (só esse é reiniciado; os workers das outras apps não são tocados)
# A Contiu não usa filas, por isso não há queue:work para reiniciar. O OPcache revalida os
# ficheiros a cada pedido, por isso o php-fpm também não precisa de reiniciar.
#
# Variáveis (valores por defeito):
#   APP_DIR=/var/www/contiu  TOOLS_CONTAINER=dockerworker  APP_CONTAINER=php-fpm
#   SCHEDULER_CONTAINER=php-worker  SCHEDULER_PROGRAM=contiu-scheduler
#   REMOTE=origin  BRANCH=main

set -Eeuo pipefail

APP_DIR="${APP_DIR:-/var/www/contiu}"
TOOLS_CONTAINER="${TOOLS_CONTAINER:-dockerworker}"
APP_CONTAINER="${APP_CONTAINER:-php-fpm}"
SCHEDULER_CONTAINER="${SCHEDULER_CONTAINER:-php-worker}"
SCHEDULER_PROGRAM="${SCHEDULER_PROGRAM:-contiu-scheduler}"
REMOTE="${REMOTE:-origin}"
BRANCH="${BRANCH:-main}"

DRY_RUN=0
SKIP_BACKUP=0
SKIP_BUILD=0
FORCE=0

for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=1 ;;
        --skip-backup) SKIP_BACKUP=1 ;;
        --skip-build) SKIP_BUILD=1 ;;
        --force) FORCE=1 ;;
        -h|--help) sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "Opção desconhecida: $arg (vê bin/release --help)" >&2; exit 2 ;;
    esac
done

# A pasta da app no servidor, para ler o .env: a do script, ou HOST_APP_DIR quando se corre
# uma cópia do script tirada de origin/main (ex.: a primeira vez, antes de o script existir lá).
HOST_APP_DIR="${HOST_APP_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"

# ── Saída ───────────────────────────────────────────────────────────────────

if [[ -t 1 ]]; then BOLD=$'\e[1m'; GREEN=$'\e[32m'; YELLOW=$'\e[33m'; RED=$'\e[31m'; RESET=$'\e[0m'; else BOLD=''; GREEN=''; YELLOW=''; RED=''; RESET=''; fi

STEP=0
CURRENT_STEP=''
step() { STEP=$((STEP + 1)); CURRENT_STEP="$1"; echo; echo "${BOLD}${STEP}. $1${RESET}"; }
info() { echo "   $*"; }
warn() { echo "${YELLOW}   ! $*${RESET}"; }
fail() { echo "${RED}✗ $*${RESET}" >&2; exit 1; }

# Corre um comando que muda alguma coisa (em --dry-run só o mostra).
run() {
    echo "   \$ $*"
    [[ $DRY_RUN -eq 1 ]] || "$@"
}

# git/composer/npm no dockerworker; artisan no php-fpm.
tools() { run docker exec -u ubuntu -w "$APP_DIR" "$TOOLS_CONTAINER" "$@"; }
artisan() { run docker exec -u www-data -w "$APP_DIR" "$APP_CONTAINER" php artisan "$@"; }

# Só leitura: corre sempre, também em --dry-run.
tools_read() { docker exec -u ubuntu -w "$APP_DIR" "$TOOLS_CONTAINER" "$@"; }

running() { [[ "$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" == "true" ]]; }

# ── Falhas ──────────────────────────────────────────────────────────────────

IN_MAINTENANCE=0
CODE_CHANGED=0

on_error() {
    local status=$?
    trap - ERR
    echo
    echo "${RED}${BOLD}✗ Falhou o passo ${STEP}: ${CURRENT_STEP}${RESET}" >&2

    if [[ $IN_MAINTENANCE -eq 1 && $CODE_CHANGED -eq 0 ]]; then
        echo "  Nada foi alterado ainda: a sair da manutenção." >&2
        artisan up || true
    elif [[ $IN_MAINTENANCE -eq 1 ]]; then
        echo "  O site ficou em MANUTENÇÃO de propósito (código e base de dados podem estar a meio)." >&2
        echo "  Corrige o problema e corre o script outra vez, ou sai da manutenção com:" >&2
        echo "    docker exec -u www-data -w $APP_DIR $APP_CONTAINER php artisan up" >&2
    fi

    exit "$status"
}
trap on_error ERR

# ── 1. Verificações (não mudam nada) ────────────────────────────────────────

[[ $DRY_RUN -eq 1 ]] && echo "${YELLOW}${BOLD}Modo --dry-run: os comandos são mostrados mas não corridos.${RESET}"

step "Verificações"

command -v docker >/dev/null || fail "Não encontro o docker neste servidor."
for container in "$TOOLS_CONTAINER" "$APP_CONTAINER" "$SCHEDULER_CONTAINER"; do
    running "$container" || fail "O container '$container' não está a correr."
done

[[ -f "$HOST_APP_DIR/artisan" ]] || fail "Não encontro a app Laravel em $HOST_APP_DIR."
[[ -f "$HOST_APP_DIR/.env" ]] || fail "Falta o ficheiro .env em $HOST_APP_DIR."

app_env="$(grep -E '^APP_ENV=' "$HOST_APP_DIR/.env" | tail -1 | cut -d= -f2- | tr -d '"'"'"' ')"
app_debug="$(grep -E '^APP_DEBUG=' "$HOST_APP_DIR/.env" | tail -1 | cut -d= -f2- | tr -d '"'"'"' ')"
[[ "$app_env" == "production" ]] || fail "O .env tem APP_ENV=$app_env; isto é para produção."
[[ "$app_debug" == "false" ]] || fail "O .env tem APP_DEBUG=$app_debug; em produção tem de ser false."

if [[ -n "$(tools_read git status --porcelain --untracked-files=no)" ]]; then
    fail "Há alterações por commitar no servidor; o git pull ia falhar. Vê: docker exec -u ubuntu -w $APP_DIR $TOOLS_CONTAINER git status"
fi

tools_read git fetch --quiet "$REMOTE" "$BRANCH"
current="$(tools_read git rev-parse --short HEAD)"
target="$(tools_read git rev-parse --short "$REMOTE/$BRANCH")"
pending="$(tools_read git log --oneline "HEAD..$REMOTE/$BRANCH")"

info "Versão atual: $current  →  nova: $target"
if [[ -z "$pending" ]]; then
    if [[ $FORCE -eq 0 ]]; then
        echo "${GREEN}   Já está tudo na última versão. Nada a fazer (usa --force para repetir o deploy).${RESET}"
        exit 0
    fi
    warn "Sem commits novos; a repetir o deploy (--force)."
else
    info "Commits a publicar:"
    echo "$pending" | sed 's/^/     /'
fi

# ── 2. Manutenção ───────────────────────────────────────────────────────────

step "Modo de manutenção (página \"Em manutenção\" da Contiu)"
artisan down --render="errors::503" --retry=60
IN_MAINTENANCE=1

# ── 3. Backup da base de dados (antes de mudar código ou dados) ─────────────

step "Backup da base de dados"
if [[ $SKIP_BACKUP -eq 1 ]]; then
    warn "Saltado (--skip-backup)."
else
    artisan backup:run --only-db --disable-notifications
fi

# ── 4. Código ───────────────────────────────────────────────────────────────

step "Código novo ($REMOTE/$BRANCH)"
CODE_CHANGED=1
tools git pull --ff-only "$REMOTE" "$BRANCH"

step "Dependências PHP (composer)"
# Sem os scripts do composer: os comandos artisan correm a seguir no php-fpm, como www-data.
tools composer install --no-dev --optimize-autoloader --no-interaction --prefer-dist --no-scripts
artisan package:discover
artisan filament:upgrade

step "Tema (npm run build)"
if [[ $SKIP_BUILD -eq 1 ]]; then
    warn "Saltado (--skip-build)."
else
    tools npm ci --no-audit --no-fund
    tools npm run build
fi

# ── 5. Base de dados ────────────────────────────────────────────────────────

step "Migrações"
artisan migrate --force

# ── 6. Caches ───────────────────────────────────────────────────────────────

step "Caches (config, rotas, eventos, views, componentes e ícones do Filament)"
artisan optimize:clear
artisan optimize
artisan filament:optimize

# ── 7. Scheduler ────────────────────────────────────────────────────────────

step "Reiniciar o scheduler ($SCHEDULER_PROGRAM, para carregar o código novo)"
run docker exec "$SCHEDULER_CONTAINER" supervisorctl restart "$SCHEDULER_PROGRAM:*"

# ── 8. Online ───────────────────────────────────────────────────────────────

step "Sair da manutenção"
artisan up
IN_MAINTENANCE=0

trap - ERR
echo
if [[ $DRY_RUN -eq 1 ]]; then
    echo "${YELLOW}${BOLD}--dry-run: nada foi alterado. Corre sem --dry-run para publicar $target.${RESET}"
else
    echo "${GREEN}${BOLD}✓ Release $target publicada.${RESET}"
fi
